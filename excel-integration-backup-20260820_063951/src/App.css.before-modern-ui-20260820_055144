/* ============================================================
   AUTOMATION STUDIO
   PREMIUM AI DATA ANALYST UI
   UI LAYER ONLY
   ============================================================ */

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color-scheme: light dark;

  /* ---------- COLOR SYSTEM ---------- */

  --primary: #7c3aed;
  --primary-2: #9333ea;
  --primary-soft: rgba(124, 58, 237, 0.12);

  --cyan: #0891b2;
  --cyan-soft: rgba(8, 145, 178, 0.12);

  --green: #059669;
  --green-soft: rgba(5, 150, 105, 0.12);

  --orange: #ea580c;
  --orange-soft: rgba(234, 88, 12, 0.12);

  --pink: #db2777;
  --pink-soft: rgba(219, 39, 119, 0.12);

  --yellow: #ca8a04;
  --yellow-soft: rgba(202, 138, 4, 0.12);

  /* ---------- LIGHT THEME ---------- */

  --bg: #f6f7fb;
  --surface: #ffffff;
  --surface-2: #fafbff;

  --text: #172033;
  --text-2: #344054;
  --muted: #667085;

  --border: #e4e7ec;

  --shadow-sm:
    0 3px 12px rgba(16, 24, 40, 0.06);

  --shadow-md:
    0 12px 35px rgba(16, 24, 40, 0.09);

  --shadow-lg:
    0 20px 55px rgba(16, 24, 40, 0.12);

  --radius-xl: 24px;
  --radius-lg: 18px;
  --radius-md: 14px;
  --radius-sm: 10px;
}

/* ============================================================
   GLOBAL
   ============================================================ */

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;

  color: var(--text);

  background:
    radial-gradient(
      circle at 8% 5%,
      rgba(124, 58, 237, 0.10),
      transparent 28%
    ),
    radial-gradient(
      circle at 92% 10%,
      rgba(8, 145, 178, 0.08),
      transparent 25%
    ),
    var(--bg);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
}

/* ============================================================
   APPLICATION FRAME
   ============================================================ */

#root {
  min-height: 100vh;
}

main,
.app,
.dashboard,
.workspace,
.container {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: 30px;
}

/* ============================================================
   HEADER / HERO
   ============================================================ */

header,
.page-header,
.workspace-header,
.hero {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;

  padding: 28px;

  margin-bottom: 24px;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.08),
      rgba(8, 145, 178, 0.06),
      rgba(219, 39, 119, 0.04)
    );

  border: 1px solid var(--border);
  border-radius: var(--radius-xl);

  box-shadow: var(--shadow-sm);
}

header::before,
.page-header::before,
.workspace-header::before,
.hero::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 5px;

  border-radius: 24px 0 0 24px;

  background:
    linear-gradient(
      180deg,
      var(--primary),
      var(--pink),
      var(--cyan)
    );
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */

h1,
h2,
h3,
h4,
h5 {
  margin-top: 0;
  color: var(--text);
  letter-spacing: -0.025em;
}

h1 {
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.08;
}

h2 {
  font-size: 26px;
}

h3 {
  font-size: 19px;
}

p {
  color: var(--muted);
  line-height: 1.65;
}

/* ============================================================
   UNIVERSAL CARD SYSTEM
   ============================================================ */

.card,
.panel,
.widget,
.analysis-card,
.upload-card,
.result-card,
.stat-card,
.summary-card,
section {
  position: relative;

  background: var(--surface);

  border: 1px solid var(--border);

  border-radius: var(--radius-lg);

  box-shadow: var(--shadow-sm);

  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.card:hover,
.panel:hover,
.widget:hover,
.analysis-card:hover,
.upload-card:hover,
.result-card:hover,
.stat-card:hover,
.summary-card:hover {
  transform: translateY(-2px);

  border-color:
    rgba(124, 58, 237, 0.22);

  box-shadow: var(--shadow-md);
}

.card,
.panel,
.widget,
.analysis-card,
.upload-card,
.result-card,
.stat-card,
.summary-card {
  padding: 22px;
}

/* ============================================================
   STRUCTURED GRID
   ============================================================ */

.grid,
.dashboard-grid,
.stats-grid,
.cards-grid {
  display: grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(220px, 1fr)
    );

  gap: 18px;

  margin: 20px 0;
}

/* ============================================================
   STAT CARDS
   ============================================================ */

.stat-card {
  overflow: hidden;
}

.stat-card::after {
  content: "";

  position: absolute;

  width: 90px;
  height: 90px;

  right: -30px;
  top: -30px;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      var(--primary-soft),
      transparent
    );
}

.stat-card:nth-child(2)::after {
  background:
    linear-gradient(
      135deg,
      var(--cyan-soft),
      transparent
    );
}

.stat-card:nth-child(3)::after {
  background:
    linear-gradient(
      135deg,
      var(--green-soft),
      transparent
    );
}

.stat-card:nth-child(4)::after {
  background:
    linear-gradient(
      135deg,
      var(--orange-soft),
      transparent
    );
}

.stat-card strong,
.stat-card .value {
  display: block;

  margin-top: 8px;

  font-size: 30px;
  line-height: 1.1;

  font-weight: 800;

  color: var(--text);
}

/* ============================================================
   TWO COLUMN STRUCTURE
   ============================================================ */

.two-column,
.content-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.45fr)
    minmax(280px, 0.75fr);

  gap: 20px;

  align-items: start;
}

/* ============================================================
   ANALYTICS SECTIONS
   ============================================================ */

.analysis,
.insights,
.results,
.summary,
.numeric-summary {
  display: grid;

  gap: 18px;
}

/* ============================================================
   UPLOAD AREA
   ============================================================ */

.upload-card {
  background:
    linear-gradient(
      135deg,
      var(--surface),
      rgba(124, 58, 237, 0.035)
    );
}

input[type="file"] {
  width: 100%;

  padding: 16px;

  border:
    1.5px dashed
    rgba(124, 58, 237, 0.35);

  border-radius: var(--radius-md);

  background:
    linear-gradient(
      135deg,
      var(--primary-soft),
      var(--surface-2)
    );

  color: var(--text);

  cursor: pointer;

  transition: 180ms ease;
}

input[type="file"]:hover {
  border-color: var(--primary);
}

/* ============================================================
   BUTTON SYSTEM
   ============================================================ */

button {
  min-height: 42px;

  padding:
    10px 17px;

  border: 0;

  border-radius: var(--radius-sm);

  color: white;

  font-weight: 700;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-2)
    );

  box-shadow:
    0 7px 18px
    rgba(124, 58, 237, 0.20);

  transition:
    transform 150ms ease,
    box-shadow 150ms ease,
    opacity 150ms ease;
}

button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 10px 24px
    rgba(124, 58, 237, 0.28);
}

button:active {
  transform: translateY(0);
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* Secondary buttons */

button.secondary,
.secondary-button {
  color: var(--text);

  background: var(--surface);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

/* ============================================================
   STATUS / BADGES
   ============================================================ */

.status,
.badge,
.chip {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding:
    7px 11px;

  border-radius: 999px;

  background: var(--primary-soft);

  color: var(--primary);

  font-size: 12px;

  font-weight: 750;
}

.online,
.ready,
.success {
  color: var(--green);
  background: var(--green-soft);
}

.warning {
  color: var(--orange);
  background: var(--orange-soft);
}

.error,
.offline {
  color: #dc2626;
  background: rgba(220, 38, 38, 0.10);
}

/* ============================================================
   TABLES
   ============================================================ */

table {
  width: 100%;

  overflow: hidden;

  border-collapse: separate;
  border-spacing: 0;

  background: var(--surface);

  border:
    1px solid
    var(--border);

  border-radius: var(--radius-md);
}

th,
td {
  padding: 14px 16px;

  text-align: left;

  border-bottom:
    1px solid
    var(--border);
}

th {
  color: var(--text);

  background:
    linear-gradient(
      135deg,
      var(--surface-2),
      var(--primary-soft)
    );

  font-weight: 750;
}

td {
  color: var(--muted);
}

tr:last-child td {
  border-bottom: 0;
}

/* ============================================================
   FORMS
   ============================================================ */

input,
select,
textarea {
  width: 100%;

  padding: 11px 13px;

  color: var(--text);

  background: var(--surface);

  border:
    1px solid
    var(--border);

  border-radius: var(--radius-sm);

  outline: none;

  transition: 150ms ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--primary);

  box-shadow:
    0 0 0 3px
    var(--primary-soft);
}

/* ============================================================
   SIDEBAR
   ============================================================ */

aside,
.sidebar {
  background: var(--surface);

  border-color: var(--border);
}

/* ============================================================
   COLOR ACCENTS
   ============================================================ */

.accent-purple {
  color: var(--primary);
}

.accent-cyan {
  color: var(--cyan);
}

.accent-green {
  color: var(--green);
}

.accent-orange {
  color: var(--orange);
}

.accent-pink {
  color: var(--pink);
}

/* ============================================================
   DARK MODE
   FOLLOWS SYSTEM DEFAULT
   ============================================================ */

@media (prefers-color-scheme: dark) {

  :root {
    --bg: #101218;

    --surface: #181b23;

    --surface-2: #20242e;

    --text: #f5f7fa;

    --text-2: #d0d5dd;

    --muted: #98a2b3;

    --border: #2d3340;

    --primary: #a78bfa;

    --primary-2: #c084fc;

    --cyan: #22d3ee;

    --green: #34d399;

    --orange: #fb923c;

    --pink: #f472b6;

    --yellow: #facc15;

    --shadow-sm:
      0 4px 18px
      rgba(0, 0, 0, 0.20);

    --shadow-md:
      0 14px 38px
      rgba(0, 0, 0, 0.28);

    --shadow-lg:
      0 24px 60px
      rgba(0, 0, 0, 0.35);
  }

  body {
    background:
      radial-gradient(
        circle at 10% 5%,
        rgba(167, 139, 250, 0.13),
        transparent 28%
      ),
      radial-gradient(
        circle at 90% 8%,
        rgba(34, 211, 238, 0.08),
        transparent 25%
      ),
      var(--bg);
  }

  input[type="file"] {
    background:
      linear-gradient(
        135deg,
        rgba(167, 139, 250, 0.08),
        var(--surface-2)
      );
  }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1000px) {

  .two-column,
  .content-grid {
    grid-template-columns: 1fr;
  }

  header,
  .page-header,
  .workspace-header,
  .hero {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 650px) {

  main,
  .app,
  .dashboard,
  .workspace,
  .container {
    padding: 14px;
  }

  .grid,
  .dashboard-grid,
  .stats-grid,
  .cards-grid {
    grid-template-columns: 1fr;
  }

  header,
  .page-header,
  .workspace-header,
  .hero {
    padding: 20px;
  }

  .card,
  .panel,
  .widget,
  .analysis-card,
  .upload-card,
  .result-card,
  .stat-card,
  .summary-card {
    padding: 17px;
  }
}

/* ============================================================
   SCROLLBAR
   ============================================================ */

* {
  scrollbar-width: thin;

  scrollbar-color:
    rgba(124, 58, 237, 0.45)
    transparent;
}
